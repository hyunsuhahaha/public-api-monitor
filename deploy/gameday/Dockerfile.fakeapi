# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /fakeapi ./cmd/fakeapi

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /fakeapi /fakeapi
EXPOSE 9000
ENTRYPOINT ["/fakeapi"]
