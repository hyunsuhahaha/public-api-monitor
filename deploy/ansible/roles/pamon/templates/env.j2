# {{ ansible_managed }}
PAMON_ROLE={{ pamon_role }}
PAMON_LOCATION={{ pamon_location }}
DATA_GO_KR_KEY={{ pamon_data_go_kr_key }}
SEOUL_OPENAPI_KEY={{ pamon_seoul_openapi_key }}
SEOUL_SUBWAY_KEY={{ pamon_seoul_subway_key }}
KAKAO_REST_API_KEY={{ pamon_kakao_rest_api_key }}
NAVER_MAPS_CLIENT_ID={{ pamon_naver_maps_client_id }}
NAVER_MAPS_CLIENT_SECRET={{ pamon_naver_maps_client_secret }}
PAMON_INGEST_TOKEN={{ pamon_ingest_token }}
PAMON_ADMIN_TOKEN={{ pamon_admin_token }}
{% if pamon_role == 'central' %}
PAMON_WEBHOOK_URL={{ pamon_webhook_url }}
PAMON_PUBLIC_URL={{ pamon_central_url }}
{% else %}
PAMON_CENTRAL_URL={{ pamon_central_url }}
{% endif %}
