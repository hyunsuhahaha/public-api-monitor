{
  "name": "pamon",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pamon-access",
    "database_id": "478cc99a-c3d0-4985-8a78-46bdc65babbf"
  }],
  // the site comes from the GCP host (deploy/gcp); GATEWAY_SECRET is a Worker secret
  "vars": {"ORIGIN_URL": "https://34-82-180-182.sslip.io"},
  "triggers": {"crons": ["0 3 * * *"]}
}
