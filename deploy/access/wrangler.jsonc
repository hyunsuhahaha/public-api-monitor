{
  "name": "pamon",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pamon-access",
    "database_id": "478cc99a-c3d0-4985-8a78-46bdc65babbf"
  }],
  // the monitor's encrypted database snapshots (see /__backup in worker.mjs)
  "kv_namespaces": [{
    "binding": "BACKUP",
    "id": "e2c4cca7d7614f9ba87d1e68de5cdc47"
  }],
  "triggers": {"crons": ["0 3 * * *"]}
}
