# cp .env.example .env 후 채우세요. .env는 커밋하지 마세요.

# 장애·복구·응답 형식 변경 알림 (Slack 또는 Discord Incoming Webhook 주소)
PAMON_WEBHOOK_URL=
# 알림의 링크에 쓸 주소 (예: http://내서버:8080)
PAMON_PUBLIC_URL=http://localhost:8080
# 운영자 메모·알림 끄기에 쓰는 관리 토큰 (아무 긴 문자열)
PAMON_ADMIN_TOKEN=

# targets.yaml이 쓰는 키
GITHUB_TOKEN=
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
DATA_GO_KR_KEY=
